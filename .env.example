# AI Diagram Copilot - Environment Configuration

# -------------------------------------------------------------
# Google Gemini API Key
# Get your API key from Google AI Studio: https://aistudio.google.com/
# -------------------------------------------------------------
GEMINI_API_KEY=

# Optional: Gemini model override (defaults to gemini-1.5-pro, can also be gemini-2.0-flash or gemini-2.5-pro)
# GEMINI_MODEL=gemini-1.5-pro

# -------------------------------------------------------------
# Other Optional AI Providers
# -------------------------------------------------------------
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# OPENAI_API_KEY=your_openai_api_key_here

# -------------------------------------------------------------
# Backend API URL (defaults to /api which is proxied to :8000 by Vite)
# -------------------------------------------------------------
# VITE_API_URL=/api

